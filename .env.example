# ─── Data mode ────────────────────────────────────────────────────────────────
# auto   → Solana if a real program ID is configured (IDL address or NEXT_PUBLIC_PROGRAM_ID), else mock
# solana → always use the MedTrace program; writes are signed in Phantom
# mock   → in-memory demo data with the program's rules (no wallet, no deploy needed)
NEXT_PUBLIC_MEDTRACE_MODE=auto

# ─── Solana ──────────────────────────────────────────────────────────────────
# devnet | localnet | testnet | mainnet-beta
NEXT_PUBLIC_CLUSTER=devnet
# Browser RPC (public). Defaults per cluster if empty (localnet → http://127.0.0.1:8899).
NEXT_PUBLIC_RPC_URL=
# Server-only RPC, e.g. a Helius devnet URL with your key. NEVER prefix with NEXT_PUBLIC_.
RPC_URL=
# Deployed program ID. Optional if anchor/idl/medtrace.json has the real "address".
NEXT_PUBLIC_PROGRAM_ID=
# Public keys of the demo wallets (printed by `npm run seed`). Public keys only.
# NEXT_PUBLIC_DEMO_WALLETS='{"manufacturer":"...","distributor":"...","pharmacy":"...","otherPharmacy":"..."}'
NEXT_PUBLIC_DEMO_WALLETS=
# Manufacturers whose packs can verify as genuine (JSON array of base58 keys).
# Empty → falls back to the manufacturer in NEXT_PUBLIC_DEMO_WALLETS. Nothing configured → check off (/status warns).
NEXT_PUBLIC_KNOWN_MANUFACTURERS=

# ─── App ─────────────────────────────────────────────────────────────────────
# Baked into every printed QR code; set to the final Vercel URL before printing.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional external read API (future indexer). Empty = this app's /api routes.
NEXT_PUBLIC_API_BASE=
